PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dating_app
# Optional alias used by many hosting platforms
# MONGODB_URI=mongodb://127.0.0.1:27017/dating_app
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_MINUTES=5
CLIENT_ORIGIN=http://localhost:3000
MONGO_CONNECT_RETRIES=5
MONGO_RETRY_DELAY_MS=2000
MONGO_FORCE_IPV4=true
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=patience.gusikowski@ethereal.email
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=Dating App <no-reply@dating-app.local>
PUBLIC_BASE_URL=https://new-dating-app-backend.vercel.app
# From Vercel Blob store → .env.local / project settings
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Supabase Realtime (broadcast only — MongoDB remains source of truth)
# Leave blank to disable realtime; clients fall back to polling.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Sign-In — OAuth Web client ID (comma-separate to accept several)
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
