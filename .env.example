PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dating_app
# Optional alias used by many hosting platforms
# MONGODB_URI=mongodb://127.0.0.1:27017/dating_app
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_MINUTES=5
CLIENT_ORIGIN=http://localhost:3000
MONGO_CONNECT_RETRIES=5
MONGO_RETRY_DELAY_MS=2000
MONGO_FORCE_IPV4=true
# Production on Railway: outbound SMTP (587/465) is blocked on most plans — use Resend over HTTPS instead.
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=Dating App <noreply@your-verified-domain.com>
#
# Local dev (SMTP):
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=patience.gusikowski@ethereal.email
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=Dating App <no-reply@dating-app.local>
# SMTP_FORCE_IPV4=true
PUBLIC_BASE_URL=https://newdatingappbackend-production.up.railway.app
# Railway volume mount path — must match the volume Mount Path in Railway UI
UPLOAD_DIR=/volume
# From Vercel Blob store → .env.local / project settings (optional if using UPLOAD_DIR)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Selfie verification with the OpenCV face service.
# Deploy ./face_service as a separate Railway service.
FACE_RECOGNITION_SERVICE_URL=http://localhost:8000
FACE_RECOGNITION_SERVICE_KEY=change-me
FACE_MATCH_THRESHOLD=0.42

# Realtime chat and notifications use the built-in WebSocket at /ws; nothing to configure.
# Optional: also mirror chat events to Supabase Realtime broadcast (SUPABASE_URL must be https://).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Sign-In — OAuth Web client ID (comma-separate to accept several)
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com


